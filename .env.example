# Copy to .env and fill in. Never commit .env (it is git-ignored).

# --- Database (used by docker-compose) ---
POSTGRES_USER=lawsuits
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lawsuits_development
DATABASE_URL=postgres://lawsuits:change-me@db:5432/lawsuits_development

# --- Rails ---
RAILS_ENV=development
# Generate with: docker compose run --rm api bin/rails secret
SECRET_KEY_BASE=replace-with-a-long-random-string

# --- Data import ---
LAWSUITS_CSV_PATH=/data/lawsuits_movements.csv

# --- LLM (Gemini) ---
# auto  = gemini when GEMINI_API_KEY is set, otherwise the offline fake provider
# gemini = always Gemini (fails with a clear error if the key is missing)
# fake  = deterministic offline summaries (always used in the test environment)
LLM_PROVIDER=auto
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=20
GEMINI_API_KEY=
