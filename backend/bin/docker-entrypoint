#!/bin/bash -e

# If running the rails server, wait for the DB and prepare it first.
if [[ "$*" == *"rails server"* ]]; then
  if [ -n "$DATABASE_URL" ]; then
    echo "Waiting for database..."
    until bin/rails runner 'ActiveRecord::Base.connection' > /dev/null 2>&1; do
      sleep 1
    done
  fi
  bin/rails db:prepare
  # Import the CSV when the lawsuits table is empty (no-op on later starts).
  bin/rails db:seed
fi

exec "${@}"
